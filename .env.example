# Values for root-owned mode0600 /etc/actor/control-plane.env.
# Match signing keys are generated per match; never put player/model credentials here.
# Candidate source: Game0.10.0 / Arena0.7.0 / Runtime0.8.0 / admission4.
# Planned v0.10.0-rc.1 is not a publication or deployment receipt. The historical
# M8 deployment used Game0.9.0/admission4; apply new versions only in a gated rollout.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
Match__PublicGameHost=<VPS_IP_OR_HOSTNAME>
Match__UnityServerExecutable=/opt/actor/agents-arena/current/AgentsArenaServer
Match__DatabasePath=/var/lib/actor/actor.db
Match__GameServerLogDirectory=/var/log/actor/matches
Match__InternalApiBaseUrl=http://127.0.0.1:5080
Match__MaxConcurrentGameServers=5
Match__GameServerPortStart=7777
Match__GameServerPortEnd=7781
Match__DefaultMaxPlayers=8
Match__LobbyStartupTimeout=45
Match__EmptyLobbyLifetime=300
Match__EmptyLobbyGracePeriod=60
Match__HeartbeatTimeout=20
Match__JoinTicketLifetime=45
Match__GameVersion=0.10.0
Match__ProtocolVersion=4
Match__AdmissionDrainFile=/run/actor-admission-drain
# Empty disables direct-loopback observer admission. Provision a distinct owned
# operator key privately; never commit it or pass it in argv/logs. This is not an
# OBS WebSocket/Twitch/Codex credential; grants observer admission/revocation only
# and does not expose the internal route through nginx. Do not copy local auth here.
Match__BroadcastOperatorKey=
