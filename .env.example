# Values for /etc/actor/control-plane.env; no persistent signing secret is needed.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
Match__PublicGameHost=<VPS_IP_OR_HOSTNAME>
Match__UnityServerExecutable=/opt/actor/agents-arena/current/AgentsArenaServer
Match__DatabasePath=/var/lib/actor/actor.db
Match__GameServerLogDirectory=/var/log/actor/matches
Match__InternalApiBaseUrl=http://127.0.0.1:5080
Match__MaxConcurrentGameServers=5
Match__GameServerPortStart=7777
Match__GameServerPortEnd=7781
Match__DefaultMaxPlayers=8
Match__LobbyStartupTimeout=45
Match__EmptyLobbyLifetime=300
Match__EmptyLobbyGracePeriod=60
Match__HeartbeatTimeout=20
Match__JoinTicketLifetime=45
Match__GameVersion=0.2.0
Match__ProtocolVersion=1
