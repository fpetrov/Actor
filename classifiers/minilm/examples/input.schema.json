            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "source",
        "payload"
      ],
      "title": "Event",
      "type": "object"
    },
    "JsonValue": {},
