<Project>
  <!-- Keep MSBuild output outside the UPM package so Unity never imports generated assemblies/sources. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../build/sdk-bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../build/sdk-obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
