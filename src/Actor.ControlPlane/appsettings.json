{
  "Urls": "http://127.0.0.1:5080",
  "Logging": {"LogLevel": {"Default": "Information", "Microsoft.AspNetCore": "Warning"}},
  "Match": {
    "MaxConcurrentGameServers": 5,
    "GameServerPortStart": 7777,
    "GameServerPortEnd": 7781,
    "DefaultMaxPlayers": 8,
    "PublicGameHost": "127.0.0.1",
    "UnityServerExecutable": "build/agents-arena-server/AgentsArenaServer",
    "DatabasePath": "runtime/actor.db",
    "GameServerLogDirectory": "runtime/matches",
    "InternalApiBaseUrl": "http://127.0.0.1:5080",
    "LobbyStartupTimeout": 45,
    "EmptyLobbyLifetime": 300,
    "EmptyLobbyGracePeriod": 60,
    "HeartbeatTimeout": 20,
    "JoinTicketLifetime": 45,
    "GameVersion": "0.2.1",
    "ProtocolVersion": "2"
  }
}
